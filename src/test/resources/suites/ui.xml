<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Browser tests (UI + hybrid). Used by the cross-browser CI matrix. -->
<suite name="UI" parallel="methods" thread-count="4" data-provider-thread-count="3">
    <listeners>
        <listener class-name="com.qa.framework.listeners.RetryTransformer"/>
        <listener class-name="com.qa.framework.listeners.TestListener"/>
    </listeners>

    <test name="UI">
        <packages>
            <package name="com.qa.tests.ui"/>
        </packages>
    </test>
    <test name="Hybrid UI + API">
        <packages>
            <package name="com.qa.tests.hybrid"/>
        </packages>
    </test>
</suite>
